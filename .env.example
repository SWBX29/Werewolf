# 环境变量配置模板

# 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 根据实际环境填写各变量值
#   3. .env 文件已被 .gitignore 忽略，不会被提交到版本库

# ---- 服务端口 ----
# 服务端 WebSocket 服务端口
PORT=3001
# 前端开发服务器端口（Vite）
VITE_PORT=5180

# ---- MongoDB 连接 ----
# MongoDB Atlas 连接字符串
# Atlas IP 白名单需设置为 0.0.0.0/0（用户名密码鉴权）
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/langrensha?retryWrites=true&w=majority

# ---- 管理员密钥 ----
# 用于 Admin 后台 API 鉴权
# 请使用强随机字符串（建议 32 位以上）
ADMIN_SECRET=

# ---- Zego 实时语音配置 ----
# Zego 控制台获取的 App ID（数字格式）
ZEGO_APP_ID=
# Zego 控制台获取的 ServerSecret（32 字节字符串，或 64 字符十六进制）
ZEGO_SERVER_SECRET=

# ---- ME Frp 内网穿透配置 ----
# 填写 mefrpc 启动参数后，服务启动时会自动使用内置 mefrpc 启动端口映射
MEFRP_ARGS=
