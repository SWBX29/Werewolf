# ============================================================================
# 狼人杀联机游戏 — 环境变量配置模板
# ============================================================================
# 使用说明：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 根据实际环境填写各变量值
#   3. .env 文件已被 .gitignore 忽略，不会被提交到版本库
# ============================================================================

# ---- 服务端口 ----
# 本地开发默认端口
PORT=3001

# ---- MongoDB 连接 ----
# MongoDB Atlas 连接字符串
# 格式：mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Atlas IP 白名单需设置为 0.0.0.0/0（用户名密码鉴权）
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/langrensha?retryWrites=true&w=majority

# ---- chmlfrp 公网地址 ----
# 通过 chmlfrp 内网穿透获取的公网 WebSocket 地址
# 本地开发时留空，系统将自动使用 localhost
# 公网部署时填写 chmlfrp 分配的地址（含端口）
# 格式：ws://xxx.chmlfrp.cn:port 或 wss://xxx.chmlfrp.cn
PUBLIC_URL=

# ---- 管理员密钥 ----
# 用于 Admin 后台 API 鉴权
# 请使用强随机字符串（建议 32 位以上）
ADMIN_SECRET=change_me_to_a_strong_random_string

# ---- Zego 实时语音配置 ----
# Zego 控制台获取的 App ID（数字格式）
ZEGO_APP_ID=0
# Zego 控制台获取的 App Sign（字符串格式）
ZEGO_APP_SIGN=
